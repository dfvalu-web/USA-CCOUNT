// UAS Accounting - Enterprise US GAAP Database Schema (Phase 1: Service-Based Businesses)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  ACCOUNTANT
  BOOKKEEPER
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COST_OF_SERVICE
}

enum AccountSubType {
  // Assets
  CASH_AND_CASH_EQUIVALENTS
  ACCOUNTS_RECEIVABLE
  ALLOWANCE_FOR_DOUBTFUL_ACCOUNTS
  PREPAID_EXPENSES
  SECURITY_DEPOSITS
  PROPERTY_PLANT_EQUIPMENT
  ACCUMULATED_DEPRECIATION
  
  // Liabilities
  ACCOUNTS_PAYABLE
  ACCRUED_EXPENSES
  UNEARNED_REVENUE_RETAINERS
  PAYROLL_TAXES_PAYABLE
  SALES_TAX_PAYABLE
  SHORT_TERM_NOTES_PAYABLE
  LONG_TERM_DEBT
  
  // Equity
  OWNERS_EQUITY
  OWNERS_DRAW
  COMMON_STOCK
  ADDITIONAL_PAID_IN_CAPITAL
  RETAINED_EARNINGS
  
  // Revenue
  SERVICE_REVENUE_HOURLY
  SERVICE_REVENUE_FIXED_FEE
  SERVICE_REVENUE_RETAINER
  SERVICE_REVENUE_SUBSCRIPTION
  OTHER_INCOME
  
  // Cost of Services (COGS equivalent for services)
  DIRECT_LABOR_SERVICE
  SUBCONTRACTOR_EXPENSE
  DIRECT_SOFTWARE_PROJECT_COSTS
  
  // Operating Expenses
  PAYROLL_WAGES
  PAYROLL_TAXES_EMPLOYER
  EMPLOYEE_BENEFITS
  SOFTWARE_AND_SAAS
  RENT_AND_FACILITIES
  MARKETING_AND_ADVERTISING
  PROFESSIONAL_FEES_LEGAL_CPA
  OFFICE_SUPPLIES
  TRAVEL_AND_ENTERTAINMENT
  INSURANCE_GENERAL_LIABILITY_E_AND_O
  BANK_AND_PAYMENT_FEES
  DEPRECIATION_EXPENSE
  OTHER_OPERATING_EXPENSE
}

enum EntryStatus {
  DRAFT
  POSTED
  VOID
}

enum AccountingBasis {
  ACCRUAL
  CASH
  BOTH
}

enum ContactType {
  CLIENT
  VENDOR
  CONTRACTOR_1099
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PricingModel {
  HOURLY
  FIXED_FEE
  RETAINER
  SUBSCRIPTION
}

enum PaymentMethod {
  ACH
  WIRE
  CREDIT_CARD
  CHECK
  CASH
  OTHER
}

model Organization {
  id              String         @id @default(uuid())
  name            String
  legalName       String?
  taxIdEin        String?        // US Employer Identification Number (EIN)
  currency        String         @default("USD")
  fiscalYearStart Int            @default(1) // 1 = January
  accountingBasis AccountingBasis @default(ACCRUAL)
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?        // US State (2 letters, e.g. CA, NY, DE)
  zipCode         String?
  country         String         @default("US")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  users           UserOrganization[]
  accounts        Account[]
  journalEntries  JournalEntry[]
  contacts        Contact[]
  invoices        Invoice[]
  payments        Payment[]
  bankTransactions BankTransaction[]

  @@map("organizations")
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  name          String
  avatarUrl     String?
  preferredLang String             @default("en") // en, pt, es
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  organizations UserOrganization[]

  @@map("users")
}

model UserOrganization {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole      @default(ACCOUNTANT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

model Account {
  id              String         @id @default(uuid())
  organizationId  String
  code            String         // E.g. "1010", "4010" (Chart of accounts numbering)
  name            String         // E.g. "Operating Checking Account", "Consulting Fee Revenue"
  namePt          String?        // Nome em Português
  nameEs          String?        // Nombre en Español
  description     String?
  type            AccountType
  subType         AccountSubType
  parentAccountId String?
  isActive        Boolean        @default(true)
  isSystem        Boolean        @default(false)
  currentBalance  Decimal        @default(0.00) @db.Decimal(15, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentAccount   Account?       @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   Account[]      @relation("AccountHierarchy")
  journalLines    JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@map("accounts")
}

model JournalEntry {
  id              String         @id @default(uuid())
  organizationId  String
  entryNumber     String         // Auto-incremented sequence per org (e.g. "JE-2026-0001")
  date            DateTime
  memo            String
  status          EntryStatus    @default(POSTED)
  basis           AccountingBasis @default(ACCRUAL)
  isAutoReversal  Boolean        @default(false)
  sourceType      String?        // "INVOICE", "PAYMENT", "PAYROLL", "MANUAL", "RECONCILIATION"
  sourceId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines           JournalLine[]

  @@index([organizationId, date])
  @@index([organizationId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0.00) @db.Decimal(15, 2)
  credit         Decimal      @default(0.00) @db.Decimal(15, 2)
  description    String?
  contactId      String?      // Reference to customer or vendor for sub-ledger reporting
  createdAt      DateTime     @default(now())

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])
  contact        Contact?     @relation(fields: [contactId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Contact {
  id              String        @id @default(uuid())
  organizationId  String
  type            ContactType
  name            String
  companyName     String?
  email           String?
  phone           String?
  taxIdSsnEin     String?       // EIN / SSN for W-9 / 1099 reporting
  is1099Eligible  Boolean       @default(false)
  billingAddress  String?
  city            String?
  state           String?
  zipCode         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  payments        Payment[]
  journalLines    JournalLine[]

  @@index([organizationId, type])
  @@map("contacts")
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  contactId       String
  invoiceNumber   String        // E.g. "INV-1001"
  issueDate       DateTime
  dueDate         DateTime
  subtotal        Decimal       @default(0.00) @db.Decimal(15, 2)
  taxAmount       Decimal       @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal       @default(0.00) @db.Decimal(15, 2)
  amountPaid      Decimal       @default(0.00) @db.Decimal(15, 2)
  balanceDue      Decimal       @default(0.00) @db.Decimal(15, 2)
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  paymentTerms    String?       // E.g. "Net 30", "Due on Receipt"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact       @relation(fields: [contactId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String       @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal      @default(1.00) @db.Decimal(10, 2) // Hours worked or service units
  unitPrice   Decimal      @default(0.00) @db.Decimal(15, 2) // Hourly rate or fixed fee
  amount      Decimal      @default(0.00) @db.Decimal(15, 2)
  pricingModel PricingModel @default(HOURLY)
  accountId   String?      // Revenue Account code

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(uuid())
  organizationId  String
  contactId       String
  invoiceId       String?
  paymentDate     DateTime
  amount          Decimal       @db.Decimal(15, 2)
  paymentMethod   PaymentMethod @default(ACH)
  referenceNumber String?       // Check number, ACH trace, Stripe charge ID
  memo            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact       @relation(fields: [contactId], references: [id])
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, paymentDate])
  @@map("payments")
}

model BankTransaction {
  id              String       @id @default(uuid())
  organizationId  String
  transactionDate DateTime
  amount          Decimal      @db.Decimal(15, 2) // Positive = deposit, Negative = withdrawal
  description     String
  category        String?
  plaidTransactionId String?
  isReconciled    Boolean      @default(false)
  matchedJournalId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, transactionDate])
  @@index([organizationId, isReconciled])
  @@map("bank_transactions")
}
